<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The languages the app's screens come in. The webview tells the page the app's
       languages (navigator.languages), so without "hi" here Settings → Language → System
       could not pick Hindi on a Mac set to Hindi. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>hi</string>
  </array>
  <!-- Magnet links can open in Fuselane. macOS keeps whatever app you already
       chose for them; System Settings or a browser's prompt picks between apps. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Magnet link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>magnet</string>
      </array>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
    </dict>
    <!-- Fuse Send links (fuselane://send/…), from the share page's Open button. -->
    <dict>
      <key>CFBundleURLName</key>
      <string>Fuse Send link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>fuselane</string>
      </array>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
    </dict>
  </array>
</dict>
</plist>
