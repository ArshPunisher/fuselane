{
  // Fuselane's upload and share-link service (BONDED-UPLOADS.md, ADR 0007).
  "name": "fuselane-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "fuselane-uploads" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fuselane",
      // Filled in when the database is created (wrangler d1 create fuselane).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "PUBLIC_URL": "https://fuselane-backend.workers.dev",
    "R2_BUCKET": "fuselane-uploads",
  },
  // Secrets (wrangler secret put): R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY.
}
